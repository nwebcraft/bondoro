# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# Rakuten API
RAKUTEN_APP_ID=your_rakuten_app_id

# Yahoo! Shopping API
YAHOO_APP_ID=your_yahoo_app_id

# AWS (for local development)
AWS_REGION=ap-northeast-1
DYNAMODB_PRODUCTS_TABLE=bondoro-products
DYNAMODB_USERS_TABLE=bondoro-users
NOTIFICATION_QUEUE_URL=https://sqs.ap-northeast-1.amazonaws.com/<account-id>/bondoro-notification-queue
